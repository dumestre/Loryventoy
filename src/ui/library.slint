import { ScrollView, VerticalBox, HorizontalBox, GridBox } from "std-widgets.slint";

// ─── Palette ───────────────────────────────────────────────────────────────

global Palette {
    out property <color> bg-deep: #121014;
    out property <color> bg-card: #242028;
    out property <color> bg-surface: #1a171c;
    out property <color> accent-start: #FFBE68;
    out property <color> accent-end: #F65D70;
    out property <color> accent: #FF9F64;
    out property <color> accent-dim: #FF9F6440;
    out property <color> text-primary: #EBE4EE;
    out property <color> text-secondary: #948490;
    out property <color> text-danger: #FF6E78;
    out property <color> border: #38323A;
    out property <color> success: #6EE7B7;
    out property <color> warning: #FCD34D;
}

// ─── Sidebar Item ──────────────────────────────────────────────────────────

component SidebarItem inherits Rectangle {
    in property <string> label-text;
    in property <bool> active: false;
    in property <image> icon;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    background: active ? Palette.accent-dim : transparent;
    animate background { duration: 150ms; }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalBox {
        padding-left: 12px;
        spacing: 8px;
        height: 36px;
        alignment: center;
        cross-axis-alignment: center;
        Image {
            source: root.icon;
            width: 18px;
            height: 18px;
        }
        Text {
            text: root.label-text;
            color: root.active ? Palette.accent : Palette.text-secondary;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
        }
    }
}

// ─── Library Card ──────────────────────────────────────────────────────────

struct LibraryItem {
    nome: string,
    tipo: string,
    tamanho: string,
    modificado: string,
    thumbnail: image,
}

component LibraryCard inherits Rectangle {
    in property <LibraryItem> item;
    callback open(string);

    background: Palette.bg-card;
    border-radius: 10px;
    border-width: 1px;
    border-color: hovered ? Palette.accent-dim : Palette.border;
    width: 160px;
    height: 180px;

    property <bool> hovered: false;
    animate border-color { duration: 150ms; }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.move { root.hovered = true; }
            if e.kind == PointerEventKind.cancel { root.hovered = false; }
        }
        clicked => { root.open(root.item.nome); }
    }

    VerticalBox {
        padding: 10px;
        spacing: 8px;
        alignment: LayoutAlignment.space-between;

        Rectangle {
            height: 100px;
            border-radius: 6px;
            background: Palette.bg-surface;
            border-width: 1px;
            border-color: Palette.border;
            Image {
                source: root.item.thumbnail;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.contain;
            }
        }

        VerticalBox {
            spacing: 4px;
            Text {
                text: root.item.nome;
                color: Palette.text-primary;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalBox {
                spacing: 6px;
                Text {
                    text: root.item.tipo;
                    color: Palette.text-secondary;
                    font-size: 10px;
                }
                Text {
                    text: root.item.tamanho;
                    color: Palette.text-secondary;
                    font-size: 10px;
                }
            }
        }
    }
}

// ─── Pages ─────────────────────────────────────────────────────────────────

component PageBiblioteca inherits Rectangle {
    in property <[LibraryItem]> itens;
    in property <string> query;
    in property <int> categoria-ativa: 0;
    callback open(string);
    callback set-query(string);
    callback select-categoria(int);

    background: Palette.bg-surface;

    VerticalBox {
        alignment: LayoutAlignment.stretch;
        padding: 24px;
        spacing: 0px;

        // Header
        HorizontalBox {
            spacing: 12px;
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;
            height: 40px;

            Text {
                text: "Biblioteca";
                font-family: "poppins";
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: TextHorizontalAlignment.start;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 0; }
            Rectangle {
                width: 240px;
                height: 34px;
                background: Palette.bg-card;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                TextInput {
                    x: 10px;
                    vertical-alignment: TextVerticalAlignment.center;
                    width: parent.width - 20px;
                    height: parent.height;
                    horizontal-alignment: TextHorizontalAlignment.start;
                    input-type: InputType.text;
                    text: "";
                    color: #dbf9e3;
                    font-size: 13px;
                    edited => { root.set-query(self.text); }
                }
            }
        }

        Rectangle { height: 16px; }

        // Categorias
        HorizontalBox {
            spacing: 8px;
            alignment: start;

            SidebarItem {
                label-text: "Todos";
                active: categoria-ativa == 0;
                clicked => { root.select-categoria(0); }
                icon: @image-url("../../icons/folder.svg");
            }
            SidebarItem {
                label-text: "Projetos";
                active: categoria-ativa == 1;
                clicked => { root.select-categoria(1); }
                icon: @image-url("../../icons/folder.svg");
            }
            SidebarItem {
                label-text: "Assets";
                active: categoria-ativa == 2;
                clicked => { root.select-categoria(2); }
                icon: @image-url("../../icons/folder.svg");
            }
            SidebarItem {
                label-text: "Templates";
                active: categoria-ativa == 3;
                clicked => { root.select-categoria(3); }
                icon: @image-url("../../icons/folder.svg");
            }
        }

        Rectangle { height: 16px; }

        // Grid de itens
        ScrollView {
            vertical-stretch: 1;
            GridBox {
                spacing: 12px;
                for item in root.itens : LibraryCard {
                    item: item;
                    open(n) => { root.open(n); }
                }
            }
        }
    }
}

// ─── Main Window ───────────────────────────────────────────────────────────

export component BibliotecaWindow inherits Window {
    title: "Loryventoy - Biblioteca";
    preferred-width: 1200px;
    preferred-height: 700px;
    min-width: 900px;
    min-height: 600px;
    background: Palette.bg-deep;

    // State properties (set from Rust)
    in-out property <[LibraryItem]> itens: [];
    in-out property <string> query: "";
    in-out property <int> categoria-ativa: 0;

    // Callbacks (connected from Rust)
    callback open(string);
    callback set-query(string);
    callback select-categoria(int);

    PageBiblioteca {
        itens: root.itens;
        query: root.query;
        categoria-ativa: root.categoria-ativa;
        open(n) => { root.open(n); }
        set-query(q) => { root.set-query(q); root.query = q; }
        select-categoria(c) => { root.select-categoria(c); }
    }
}
